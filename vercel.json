{
  "buildCommand": "pnpm build:client",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
